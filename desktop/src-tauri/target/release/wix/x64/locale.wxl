<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch SupremeAI Desktop</String><String Id="DowngradeErrorMessage">A newer version of SupremeAI Desktop is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the SupremeAI Desktop executable to the PATH system environment variable. This allows the SupremeAI Desktop executable to be called from any location.</String><String Id="InstallAppFeature">Installs SupremeAI Desktop.</String></WixLocalization>